        data.append(("Federal Tax Total:", f"${r['federal_tax']:,.2f}", "#c62828"))

        data.append(("", "", ""))

        # State tax section
        state_name = self.state_var.get()
        state_type = r['state_tax_type']

        if state_type == "none":
            data.append((f"STATE TAX ({state_name})", None, None))
            data.append(("No state income tax", "$0.00", "#333"))
        elif state_type == "flat":
            data.append((f"STATE TAX ({state_name}) - Flat Rate", None, None))
            if r['state_breakdown']:
                b = r['state_breakdown'][0]
