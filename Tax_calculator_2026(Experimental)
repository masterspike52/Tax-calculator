        else:
            data.append((f"STATE TAX ({state_name}) - Progressive", None, None))
            for b in r['state_breakdown']:
                data.append((f"  {b['bracket']} @ {b['rate']}:", f"${b['tax']:,.2f}", "#c62828"))

        data.append(("State Tax Total:", f"${r['state_tax']:,.2f}", "#c62828"))

        data.append(("", "", ""))
        data.append(("TOTAL TAXES:", f"${r['total_tax']:,.2f}", "#c62828"))

        data.append(("", "", ""))
        data.append(("TAKE HOME", None, None))
        data.append(("Annual:", f"${r['annual_take_home']:,.2f}", "#2e7d32"))
        data.append(("Monthly:", f"${r['monthly_take_home']:,.2f}", "#2e7d32"))
        data.append(("Weekly:", f"${r['weekly_take_home']:,.2f}", "#2e7d32"))
        data.append(("Hourly (effective):", f"${r['hourly_take_home']:,.2f}/hr", "#2e7d32"))

        # Render all rows
        row_idx = 0
        for label, value, color in data:
            if value is None:
                tk.Label(details, text=label, font=('Helvetica', 11, 'bold'),
                         bg="#ffffff").grid(row=row_idx, column=0, columnspan=2, sticky="w", pady=(10, 5))
            elif label == "":
                row_idx += 1
                continue
            else:
                bold = label in ["Annual Gross:", "TOTAL TAXES:", "Hourly (effective):", 
                                "Federal Tax Total:", "State Tax Total:", "FICA Total:", 
                                "SE Tax Total:", "Adjusted Gross Income:"]
                font = ('Helvetica', 10, 'bold') if bold else ('Helvetica', 10)
                tk.Label(details, text=label, font=font, bg="#ffffff").grid(row=row_idx, column=0, sticky="w", pady=2)
