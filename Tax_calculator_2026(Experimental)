                         font=('Helvetica', 9), bg="#f5f5f5").pack(anchor="w")

        disclaimer = tk.Label(scroll_frame,
                              text="⚠️ 2026 values are ESTIMATES based on projected inflation. Consult IRS.gov for official figures when released.",
                              font=('Helvetica', 8, 'italic'), bg="#ffffff", fg="#757575", wraplength=600)
        disclaimer.pack(pady=10)


